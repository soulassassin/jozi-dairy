# Jozi Dairy CRM (required for /crm to run)

# Shared passcode the sales team types to sign in.
CRM_PASSCODE=change-me-to-a-team-passcode

# Signs the session cookie. Use a long random string (32+ characters).
# Rotating this signs everyone out.
CRM_SESSION_SECRET=change-me-to-a-long-random-secret-string

# Optional: where the CRM lead file lives. Defaults to ./data
# CRM_DATA_DIR=./data


# ---------------------------------------------------------------------------
# Email notifications for new website leads
# ---------------------------------------------------------------------------
# With nothing set below, the CRM still captures leads and prints the email it
# would have sent to the server log. Set ONE of the two transports to send for
# real.

# Link in the notification email. Set this to your live domain in production.
CRM_BASE_URL=http://localhost:3000

# Option A — send through Jozi Dairy's own mailbox (normal VPS / shared host).
# The plain SMTP_* names are also accepted, if your host already sets them.
# CRM_SMTP_HOST=mail.jozidairy.co.za      (or SMTP_HOST)
# CRM_SMTP_PORT=587                       (or SMTP_PORT)
# CRM_SMTP_USER=no-reply@jozidairy.co.za  (or SMTP_USER)
# CRM_SMTP_PASSWORD=the-mailbox-password   (or SMTP_PASS)
# CRM_SMTP_SECURE=false                   (or SMTP_SECURE; true for port 465)

# Option B — send over HTTPS instead. Use this if your host blocks outbound
# SMTP (Vercel and similar). Sign up at resend.com and verify the domain.
# RESEND_API_KEY=re_xxxxxxxxxxxx

# The From address. Must be a mailbox/domain the transport is allowed to send as.
# CRM_MAIL_FROM=Jozi Dairy Website <no-reply@jozidairy.co.za>

# Routing. By default, every website lead is sent to all three designated addresses:
# ashley@jozidairy.co.za, sherazaad@synapsesnetworking.com, operations@jozidairy.co.za.
# CRM_NOTIFY_TO overrides that list; CRM_NOTIFY_CC adds extra copies.
# CRM_NOTIFY_TO=ashley@jozidairy.co.za,sherazaad@synapsesnetworking.com,operations@jozidairy.co.za
# CRM_NOTIFY_CC=management@jozidairy.co.za

# Force a transport instead of auto-detecting: smtp | resend | console
# CRM_MAIL_TRANSPORT=smtp

# Turn notifications off without removing the settings above.
# CRM_NOTIFY_ENABLED=false

# ---------------------------------------------------------------------------
# Search Engine Optimization (SEO) & Canonical Domain Resolution
# ---------------------------------------------------------------------------
# Canonical site base URL used for sitemap generation, canonical tags, OpenGraph,
# and structured data. Defaults to https://www.jozidairy.co.za if omitted.
# NEXT_PUBLIC_SITE_URL=https://www.jozidairy.co.za
# SITE_URL=https://www.jozidairy.co.za

# ---------------------------------------------------------------------------
# Google Search Console (GSC) Ownership Verification
# ---------------------------------------------------------------------------
# Zero-code site ownership verification. Set either Option 1 or Option 2 below.

# Option 1 (Recommended) — Verification Meta Tag
# Paste the verification token provided by Google Search Console under "HTML tag".
# Next.js will automatically inject <meta name="google-site-verification" content="..." />
# into the <head> of the root layout.
# Leave commented out or empty if not configuring GSC or using DNS verification.
# GOOGLE_SITE_VERIFICATION=your-google-verification-token-here
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your-google-verification-token-here

# Option 2 — HTML Verification File Route
# If using Google's "HTML file" verification method, specify the exact filename
# downloaded from Search Console (e.g., google1234567890abcdef.html).
# A dynamic Route Handler serves the required confirmation text at this URL.
# GOOGLE_SITE_VERIFICATION_HTML=google1234567890abcdef.html


# ---------------------------------------------------------------------------
# Split deployment: marketing site and CRM on different hosts
# ---------------------------------------------------------------------------
# The public site suits a CDN platform (Vercel). The CRM needs a persistent
# filesystem for data/crm.json, so it belongs on a normal Node host. Leave
# both of these unset when one deployment serves everything.

# ON THE PUBLIC SITE (e.g. Vercel): where the quote and contact forms post.
# Without this, enquiries hit the site's own serverless /api/inquiries, which
# has a throwaway disk — capture refuses rather than losing them, so the forms
# would show an error. Point it at the CRM host instead.
# NEXT_PUBLIC_INQUIRY_ENDPOINT=https://crm.jozidairy.co.za/api/inquiries

# ON THE CRM HOST: which public origins may post an enquiry cross-origin.
# Required for the split setup, or the browser's CORS preflight is refused.
# CRM_ALLOWED_ORIGINS=https://www.jozidairy.co.za,https://jozidairy.co.za

# Escape hatch: accept leads even where they cannot be persisted. Only for a
# throwaway preview deployment — on a serverless host this loses enquiries.
# CRM_ALLOW_EPHEMERAL_STORE=true
