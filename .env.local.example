# Jozi Dairy CRM (required for /crm to run)

# Shared passcode the sales team types to sign in.
CRM_PASSCODE=change-me-to-a-team-passcode

# Signs the session cookie. Use a long random string (32+ characters).
# Rotating this signs everyone out.
CRM_SESSION_SECRET=change-me-to-a-long-random-secret-string

# Optional: where the CRM lead file lives. Defaults to ./data
# CRM_DATA_DIR=./data


# ---------------------------------------------------------------------------
# Email notifications for new website leads
# ---------------------------------------------------------------------------
# With nothing set below, the CRM still captures leads and prints the email it
# would have sent to the server log. Set ONE of the two transports to send for
# real.

# Link in the notification email. Set this to your live domain in production.
CRM_BASE_URL=http://localhost:3000

# Option A — send through Jozi Dairy's own mailbox (normal VPS / shared host).
# The plain SMTP_* names are also accepted, if your host already sets them.
# CRM_SMTP_HOST=mail.jozidairy.co.za      (or SMTP_HOST)
# CRM_SMTP_PORT=587                       (or SMTP_PORT)
# CRM_SMTP_USER=no-reply@jozidairy.co.za  (or SMTP_USER)
# CRM_SMTP_PASSWORD=the-mailbox-password   (or SMTP_PASS)
# CRM_SMTP_SECURE=false                   (or SMTP_SECURE; true for port 465)

# Option B — send over HTTPS instead. Use this if your host blocks outbound
# SMTP (Vercel and similar). Sign up at resend.com and verify the domain.
# RESEND_API_KEY=re_xxxxxxxxxxxx

# The From address. Must be a mailbox/domain the transport is allowed to send as.
# CRM_MAIL_FROM=Jozi Dairy Website <no-reply@jozidairy.co.za>

# Routing. By default, every website lead is sent to all three designated addresses:
# ashley@jozidairy.co.za, sherazaad@synapsesnetworking.com, operations@jozidairy.co.za.
# CRM_NOTIFY_TO overrides that list; CRM_NOTIFY_CC adds extra copies.
# CRM_NOTIFY_TO=ashley@jozidairy.co.za,sherazaad@synapsesnetworking.com,operations@jozidairy.co.za
# CRM_NOTIFY_CC=management@jozidairy.co.za

# Force a transport instead of auto-detecting: smtp | resend | console
# CRM_MAIL_TRANSPORT=smtp

# Turn notifications off without removing the settings above.
# CRM_NOTIFY_ENABLED=false
